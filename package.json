{
  "name": "minimal-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp 404.html dist/",
    "preview": "vite preview",
    "test": "vitest run",
    "build:staging": "vite build --base /blog/staging/ --outDir dist-staging && cp 404.html dist-staging/",
    "test:staging": "playwright test e2e/staging.check.js"
  },
  "dependencies": {
    "marked": "^18.2.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
