{
  "name": "minimal-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp 404.html dist/",
    "preview": "vite preview",
    "test": "vitest run",
    "build:staging": "vite build --base /blog/staging/ --outDir dist-staging && cp 404.html dist-staging/",
    "test:staging": "playwright test e2e/staging.check.js"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.3",
    "jsdom": "^24.0.0",
    "vite": "^5.1.6",
    "vitest": "^1.6.1"
  }
}
